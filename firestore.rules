rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verified() { return request.auth != null && request.auth.token.email_verified == true; }
  function admin() { return verified() && request.auth.token.email == 'kstouras@gmail.com'; }
  function instructor() { return admin() || (verified() && exists(/databases/$(database)/documents/instructors/$(request.auth.token.email))); }
  function session(code) { return get(/databases/$(database)/documents/sessions/$(code)).data; }
  function owner(code) { return admin() || (verified() && session(code).owner == request.auth.uid && (instructor() || session(code).get('mode','individual')=='solo'));  }
  function own(uid) { return verified() && request.auth.uid == uid; }
  function member(code,uid) { return exists(/databases/$(database)/documents/sessions/$(code)/participants/$(uid)); }
  function captain(code,uid) { return session(code).get('mode','individual')!='team' || session(code).assignments.get(uid,'')==uid; }
  function teammate(code,uid) { return verified() && member(code,request.auth.uid) && session(code).get('mode','individual')=='team' && session(code).assignments.get(request.auth.uid,'')==uid; }
  function lockedTeamRound(code,uid,r) { let s=session(code); return verified() && member(code,request.auth.uid) && s.get('mode','individual')=='team' && uid in s.teamNames && r in ['0','1','2','3'] && s.startedAt!=null && request.time>=s.startedAt+duration.value(split(r),'s') && (s.closedAt==null || s.closedAt>=s.startedAt+duration.value(split(r),'s')); }
  function start(r) { return r=='0'?0:r=='1'?180:r=='2'?420:660; }
  function split(r) { return r=='0'?90:r=='1'?420:r=='2'?540:810; }
  function end(r) { return r=='0'?180:r=='1'?420:r=='2'?660:960; }
  function inWindow(code,a,b) { let s=session(code); return s.status=='running' && request.time >= s.startedAt+duration.value(a,'s') && request.time < s.startedAt+duration.value(b,'s'); }
  function orderShape(r) { let d=request.resource.data; return d.keys().hasOnly(['variety','quantity','cap','savedAt']) && d.keys().hasAll(['variety','quantity','cap','savedAt']) && d.variety is int && (d.variety==4 || (r=='3' && d.variety==8)) && d.quantity is int && d.quantity>=0 && d.quantity<=200 && d.cap is int && d.cap>=0 && d.cap<=200 && d.savedAt==request.time; }
  function bounded(c,k,lo,hi) { return c[k] is number && c[k]>=lo && c[k]<=hi; }
  function configShape(c) { return c.keys().hasOnly(['demandMean','demandSd','forecastSd','rebound','price','initialCost','refillCost','styleCost','salvage','unitCarbon','leftoverCarbon']) && bounded(c,'demandMean',80,2000) && bounded(c,'demandSd',0,1000) && bounded(c,'forecastSd',0,0.8) && bounded(c,'rebound',0,1) && bounded(c,'price',1,500) && bounded(c,'initialCost',0,500) && bounded(c,'refillCost',0,500) && bounded(c,'styleCost',0,5000) && bounded(c,'salvage',0,500) && bounded(c,'unitCarbon',0,100) && bounded(c,'leftoverCarbon',0,100) && c.salvage<=c.initialCost && c.salvage<=c.refillCost && c.salvage<=c.price; }
  // Private identity details; never permissions, passwords or client-supplied scores.
  match /profiles/{uid} {
   function self() { return request.auth != null && request.auth.uid == uid; }
   function textField(k,n) { return request.resource.data[k] is string && request.resource.data[k].size()>0 && request.resource.data[k].size()<=n; }
   function optionalText(k,n) { return !(k in request.resource.data) || textField(k,n); }
   function portalField(p,k) { return !(k in p) || (p[k] is string && p[k].size()<=200); }
   function portalShape(p) { return p is map && p.keys().hasOnly(['name','email','studentId','age','gender','nationality','country','levelOfStudy','workExperience','occupation','industry','englishFluency','createdAt','updatedAt']) && portalField(p,'name') && portalField(p,'email') && portalField(p,'studentId') && portalField(p,'age') && portalField(p,'gender') && portalField(p,'nationality') && portalField(p,'country') && portalField(p,'levelOfStudy') && portalField(p,'workExperience') && portalField(p,'occupation') && portalField(p,'industry') && portalField(p,'englishFluency') && portalField(p,'createdAt') && portalField(p,'updatedAt'); }
   allow get: if self();
   allow create,update: if self() && request.resource.data.keys().hasOnly(['firstName','lastName','universityId','platformRegistration']) && optionalText('firstName',60) && optionalText('lastName',60) && optionalText('universityId',80) && (!('platformRegistration' in request.resource.data) || portalShape(request.resource.data.platformRegistration));
   match /sessions/{code} {
    allow read: if own(uid);
    allow create,update: if own(uid) && getAfter(/databases/$(database)/documents/sessions/$(code)/participants/$(uid)).data.joinedAt is timestamp && request.resource.data.keys().hasOnly(['joined']) && request.resource.data.joined==true;
   }
  }
  match /settings/defaults { allow read: if instructor(); allow create,update: if admin() && configShape(request.resource.data); }
  match /instructors/{email} {
   allow get: if admin() || (verified() && request.auth.token.email==email);
   allow list, delete: if admin();
   allow create, update: if admin() && email.matches('^[^/ @]+@[^/ @]+[.][^/ @]+$') && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt==request.time;
  }
  match /sessions/{code} {
   allow get: if verified();
   allow list: if admin() || (instructor() && resource.data.owner==request.auth.uid);
   allow create: if verified() && (instructor() || request.resource.data.get('mode','individual')=='solo') && code.matches('^[A-Z2-9]{8}$') && request.resource.data.keys().hasOnly(['name','owner','config','seed','status','createdAt','startedAt','closedAt','mode','assignments','teamNames','rosterVersion']) && request.resource.data.get('mode','individual') in ['individual','team','solo'] && request.resource.data.get('rosterVersion',0)==0 && request.resource.data.get('assignments',{})=={} && request.resource.data.get('teamNames',{})=={} && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80 && request.resource.data.owner==request.auth.uid && configShape(request.resource.data.config) && request.resource.data.seed is int && request.resource.data.seed>=0 && request.resource.data.seed<=1000000 && request.resource.data.status=='lobby' && request.resource.data.createdAt==request.time && request.resource.data.startedAt==null && request.resource.data.closedAt==null;
   // Joining increments a revision atomically; team assignment/start transactions retry on a concurrent join.
   allow update: if verified() && resource.data.status=='lobby' && resource.data.get('mode','individual')=='team' && !member(code,request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rosterVersion']) && request.resource.data.rosterVersion is int && request.resource.data.rosterVersion==resource.data.get('rosterVersion',0)+1 && getAfter(/databases/$(database)/documents/sessions/$(code)/participants/$(request.auth.uid)).data.joinedAt==request.time;
   allow update: if owner(code) && ((resource.data.status=='lobby' && resource.data.get('mode','individual')=='team' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignments','teamNames']) && request.resource.data.assignments is map && request.resource.data.teamNames is map && request.resource.data.assignments.size()<=500 && request.resource.data.teamNames.size()<=100) || (resource.data.status=='lobby' && request.resource.data.status=='running' && request.resource.data.startedAt==request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','startedAt'])) || (resource.data.status in ['lobby','running'] && request.resource.data.status=='closed' && request.resource.data.closedAt==request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt'])));
   match /participants/{uid} {
    allow get: if own(uid) || owner(code);
    allow list: if owner(code);
    allow create: if own(uid) && (session(code).get('mode','individual')!='solo' || session(code).owner==request.auth.uid) && session(code).status=='lobby' && (session(code).get('mode','individual')!='team' || getAfter(/databases/$(database)/documents/sessions/$(code)).data.rosterVersion==session(code).get('rosterVersion',0)+1) && request.resource.data.keys().hasOnly(['name','email','joinedAt']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80 && request.resource.data.email==request.auth.token.email && request.resource.data.joinedAt==request.time;
    match /orders/{r} {
     allow get: if own(uid) || owner(code) || teammate(code,uid) || lockedTeamRound(code,uid,r);
     allow list: if own(uid) || owner(code) || teammate(code,uid);
     allow create: if own(uid) && captain(code,uid) && member(code,uid) && r in ['0','1','2','3'] && orderShape(r) && ((inWindow(code,start(r),split(r)) && request.resource.data.cap==0) || (r!='1' && inWindow(code,split(r),end(r)) && request.resource.data.quantity==80 && request.resource.data.variety==4));
     allow update: if own(uid) && captain(code,uid) && member(code,uid) && r in ['0','1','2','3'] && orderShape(r) && ((inWindow(code,start(r),split(r)) && request.resource.data.cap==0) || (r!='1' && inWindow(code,split(r),end(r)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cap','savedAt'])));
    }
   }
  }
 }
}
